---
import "../styles/fonts.css";
import "../styles/vendor/sumi.css";
import "../styles/global.css";
import Curiosity from "../components/Curiosity.astro";
import { site } from "../data/site";
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={site.description} />
    <meta name="theme-color" content="#F7F5EF" />
    <link rel="canonical" href={Astro.site} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={site.title} />
    <meta property="og:description" content={site.description} />
    <meta property="og:url" content={Astro.site} />
    <meta
      property="og:image"
      content={new URL(site.socialPreview.src, Astro.site)}
    />
    <meta property="og:image:alt" content={site.socialPreview.alt} />
    <title>{site.title}</title>
  </head>
  <body id="top" class:list={{ "has-image-panel": site.imagePanel.show }}>
    <a class="skip-link" href="#main-content">
      Skip to content
    </a>
    {site.imagePanel.show && (
      <aside
        class="image-panel"
        aria-label={site.imagePanel.label}
        style={`--image-panel-image: url(${JSON.stringify(site.imagePanel.src)})`}
      >
        <div class="image-panel-top" aria-hidden="true">
          <span class="image-monogram">
            {site.imagePanel.monogram}
            <span>·</span>
          </span>
          <span>{site.imagePanel.collectionLabel}</span>
        </div>
        <div class="image-panel-bottom">
          <p class="image-panel-caption">
            {site.imagePanel.caption.text}
            <br />
            <em>{site.imagePanel.caption.emphasis}</em>
          </p>
          <div class="image-panel-foot">
            <span aria-hidden="true">{site.imagePanel.motto}</span>
          </div>
        </div>
      </aside>
    )}
    <div class="sheet">
      <header class="masthead">
        <div class="nameplate">
          <a href="/" aria-label={`${site.name} — home`}>
            {site.name}
          </a>
          <span class="header-sigil" aria-hidden="true"></span>
        </div>
      </header>

      <main id="main-content" class="editorial">
        <section id="now" class="intro-column" aria-labelledby="now-heading">
          <h2 id="now-heading" class="column-heading">
            {site.skills.heading}
          </h2>
          <fieldset class="facts-box">
            <legend>{site.skills.legend}</legend>
            <dl class="now-list">
              {site.skills.items.map(item => (
                <div>
                  <dt>{item.label}</dt>
                  <dd>{item.text}</dd>
                </div>
              ))}
            </dl>
          </fieldset>
          <div class="margin-copy">
            <span class="margin-label">{site.introduction.label}</span>
            <div>
              {site.introduction.paragraphs.map(paragraph => (
                <p>{paragraph}</p>
              ))}
            </div>
          </div>
          {site.pullQuote.show && (
            <h1 class="pull-quote">
              “{site.pullQuote.text}”
              <br />–{" "}
              {site.pullQuote.sourceUrl ? (
                <a href={site.pullQuote.sourceUrl}>
                  {site.pullQuote.attribution}
                </a>
              ) : (
                site.pullQuote.attribution
              )}
            </h1>
          )}
          <div class="margin-copy">
            <span class="margin-label">{site.colophon.label}</span>
            <div>
              {site.colophon.paragraphs.map(paragraph => (
                <p>{paragraph}</p>
              ))}
            </div>
          </div>
        </section>
        <section
          id="about"
          class="details-column"
          aria-labelledby="about-heading"
        >
          <h2 id="about-heading" class="column-heading">
            {site.about.heading}
          </h2>
          <div class="margin-copy history">
            <span class="margin-label">{site.about.label}</span>
            <div>
              {site.about.paragraphs.map(paragraph => (
                <p>{paragraph}</p>
              ))}
            </div>
          </div>
          {site.graphic.show && <Curiosity {...site.graphic} />}
          {site.projects.show && (
            <section
              id="projects"
              class="caption-section projects-panel"
              aria-labelledby="projects-heading"
            >
              <h3 id="projects-heading">{site.projects.heading}</h3>
              <p class="margin-label">{site.projects.subtitle}</p>
              <ul class="project-links">
                {site.projects.items.map(project => (
                  <li>
                    <a href={project.href}>{project.label} ↗</a>
                    <p>{project.description}</p>
                  </li>
                ))}
              </ul>
            </section>
          )}
          <section
            id="contact"
            class="caption-section"
            aria-labelledby="contact-heading"
          >
            <h3 id="contact-heading">{site.contact.heading}</h3>
            <div class="caption-columns">
              <p>{site.contact.text}</p>
              <div>
                <a class="email-link" href={`mailto:${site.contact.email}`}>
                  {site.contact.email} ↗
                </a>
                <ul class="elsewhere">
                  {site.contact.links.map(link => (
                    <li>
                      <a href={link.href} target="_blank">
                        {link.label} ↗
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </section>
        </section>
      </main>
      {site.footer.show && (
        <footer class="colophon">
          <span>
            © {new Date().getFullYear()}{" "}
            {site.footer.copyrightName ?? site.name}
          </span>
          {site.footer.note.show && (
            <span class="colophon-note">{site.footer.note.text}</span>
          )}
          {site.footer.backToTop.show && (
            <a href="#top" aria-label={site.footer.backToTop.label}>
              {site.footer.backToTop.label} <span aria-hidden="true">↑</span>
            </a>
          )}
        </footer>
      )}
    </div>
  </body>
</html>
