---
import "../styles/fonts.css";
import "../styles/vendor/sumi.css";
import "../styles/global.css";
import Curiosity from "../components/Curiosity.astro";
import { site } from "../data/site";
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={site.description} />
    <meta name="theme-color" content="#F7F5EF" />
    <link rel="canonical" href={Astro.site} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={site.title} />
    <meta property="og:description" content={site.description} />
    <meta property="og:url" content={Astro.site} />
    <meta
      property="og:image"
      content={new URL("/social-card.png", Astro.site)}
    />
    <title>{site.title}</title>
  </head>
  <body id="top">
    <a class="skip-link" href="#main-content">
      Skip to content
    </a>
    <aside class="image-panel" aria-label="Ocean photograph">
      <div class="image-panel-top" aria-hidden="true">
        <span class="image-monogram">
          SJT<span>·</span>
        </span>
        <span>A personal collection</span>
      </div>
      <div class="image-panel-bottom">
        <p class="image-panel-caption">
          A wider
          <br />
          <em>perspective.</em>
        </p>
        <div class="image-panel-foot">
          <span aria-hidden="true">Stay curious. Look closer.</span>
          <a
            href="https://unsplash.com/photos/an-aerial-view-of-a-body-of-water-UzVDOE3OCbg"
            aria-label="Ocean photograph by Annie Spratt on Unsplash"
          >
            Photo: Annie Spratt ↗
          </a>
        </div>
      </div>
    </aside>
    <div class="sheet">
      <header class="masthead">
        <div class="nameplate">
          <a href="/" aria-label={`${site.name} — home`}>
            {site.name}
          </a>
          <span class="edition" aria-label="Edition one">
            01
          </span>
        </div>
      </header>

      <main id="main-content" class="editorial">
        <section id="now" class="intro-column" aria-labelledby="now-heading">
          <h2 id="now-heading" class="column-heading">
            What I do
          </h2>
          <fieldset class="facts-box">
            <legend>Skills &amp; Interests</legend>
            <dl class="now-list">
              {site.now.map(item => (
                <div>
                  <dt>{item.label}</dt>
                  <dd>{item.text}</dd>
                </div>
              ))}
            </dl>
          </fieldset>
          <div class="margin-copy">
            <span class="margin-label">A few words to begin</span>
            <p>{site.introduction}</p>
          </div>
          <h1 class="pull-quote">
            “Engineering is not quite as important as imagination."
            <br />– Satoru Iwata
          </h1>
          <div class="margin-copy">
            <span class="margin-label">Drawn to</span>
            <p>{site.interests}</p>
          </div>
        </section>
        <section
          id="about"
          class="details-column"
          aria-labelledby="about-heading"
        >
          <h2 id="about-heading" class="column-heading">
            Who I am
          </h2>
          <div class="margin-copy history">
            <span class="margin-label">The person behind the page</span>
            <div>
              {site.about.map(paragraph => (
                <p>{paragraph}</p>
              ))}
            </div>
          </div>
          <Curiosity />
          <section
            id="projects"
            class="caption-section projects-panel"
            aria-labelledby="projects-heading"
          >
            <h3 id="projects-heading">What I’m doing now</h3>
            <p class="margin-label">Projects &amp; experiments</p>
            <ul class="project-links">
              {site.projects.map(project => (
                <li>
                  <a href={project.href}>{project.label} ↗</a>
                  <p>{project.description}</p>
                </li>
              ))}
            </ul>
          </section>
          <section
            id="contact"
            class="caption-section"
            aria-labelledby="contact-heading"
          >
            <h3 id="contact-heading">Keep in touch</h3>
            <div class="caption-columns">
              <p>{site.contact}</p>
              <div>
                <a class="email-link" href={`mailto:${site.email}`}>
                  {site.email} ↗
                </a>
                <ul class="elsewhere">
                  {site.links.map(link => (
                    <li>
                      <a href={link.href}>{link.label} ↗</a>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </section>
        </section>
      </main>
      <footer class="colophon">
        <span>
          © {new Date().getFullYear()} {site.name}
        </span>
        <span class="colophon-note">Made with care. Best read slowly.</span>
        <a href="#top" aria-label="Back to top">
          Back to top <span aria-hidden="true">↑</span>
        </a>
      </footer>
    </div>
  </body>
</html>
