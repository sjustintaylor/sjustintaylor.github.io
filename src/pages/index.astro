---
import "../styles/fonts.css";
import "../styles/vendor/sumi.css";
import "../styles/global.css";
import Curiosity from "../components/Curiosity.astro";
import { site } from "../data/site";
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={site.description} />
    <meta name="theme-color" content="#F7F5EF" />
    <link rel="canonical" href={Astro.site} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={site.title} />
    <meta property="og:description" content={site.description} />
    <meta property="og:url" content={Astro.site} />
    <meta
      property="og:image"
      content={new URL("/social-card.png", Astro.site)}
    />
    <title>{site.title}</title>
  </head>
  <body id="top">
    <a class="skip-link" href="#main-content">
      Skip to content
    </a>
    <div class="sheet">
      <header class="masthead">
        <div class="edition-line">
          <span>A personal collection</span>
          <span>Ideas, work & everyday life</span>
        </div>
        <div class="nameplate">
          <a href="/" aria-label={`${site.name} — home`}>
            {site.name}
          </a>
          <span class="edition" aria-label="Edition one">
            01
          </span>
        </div>
        <nav aria-label="On this page">
          <span class="nav-note">Always a work in progress.</span>
          <div>
            <a href="#about">About</a>
            <a href="#now">Now</a>
            <a href="#contact">
              Contact <span aria-hidden="true">↗</span>
            </a>
          </div>
        </nav>
      </header>

      <main id="main-content" class="editorial">
        <div class="intro-column">
          <section class="introduction" aria-labelledby="intro-heading">
            <p class="eyebrow">
              <span class="diamond" aria-hidden="true">
                ◆
              </span>{" "}
              A few words to begin
            </p>
            <h1 id="intro-heading">
              A curious mind.
              <br />A considered
              <br />
              <em>life.</em>
            </h1>
            <p class="standfirst">{site.introduction}</p>
            <a class="text-link" href="#about">
              A little more about me <span aria-hidden="true">↓</span>
            </a>
          </section>
          <Curiosity />
          <aside class="field-notes" aria-label="A note on this page">
            <span class="eyebrow">A note in the margin</span>
            <p>
              A few things in progress.
              <br />A little space for what comes next.
            </p>
          </aside>
        </div>
        <div class="details-column">
          <section
            id="about"
            class="editorial-section"
            aria-labelledby="about-heading"
          >
            <div class="section-heading">
              <h2 id="about-heading">A little about me</h2>
              <span aria-hidden="true">01</span>
            </div>
            <p class="section-kicker">The person behind the page</p>
            {site.about.map(paragraph => (
              <p>{paragraph}</p>
            ))}
            <dl class="interests">
              <dt>Drawn to</dt>
              <dd>{site.interests.join(" · ")}</dd>
            </dl>
          </section>
          <section
            id="now"
            class="editorial-section"
            aria-labelledby="now-heading"
          >
            <div class="section-heading">
              <h2 id="now-heading">In the here & now</h2>
              <span aria-hidden="true">02</span>
            </div>
            <p class="section-kicker">A small snapshot of the present</p>
            <dl class="now-list">
              {site.now.map(item => (
                <div>
                  <dt>{item.label}</dt>
                  <dd>{item.text}</dd>
                </div>
              ))}
            </dl>
          </section>
          <section
            id="contact"
            class="editorial-section contact"
            aria-labelledby="contact-heading"
          >
            <div class="section-heading">
              <h2 id="contact-heading">Keep in touch</h2>
              <span aria-hidden="true">03</span>
            </div>
            <p>{site.contact}</p>
            <a class="email-link" href={`mailto:${site.email}`}>
              {site.email}
              <span aria-hidden="true">↗</span>
            </a>
            <div class="elsewhere">
              <span>Elsewhere</span>
              <ul>
                {site.links.map(link => (
                  <li>
                    <a href={link.href}>
                      {link.label}
                      <span aria-hidden="true">↗</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </section>
        </div>
      </main>
      <footer class="colophon">
        <span>
          © {new Date().getFullYear()} {site.name}
        </span>
        <span class="colophon-note">Made with care. Best read slowly.</span>
        <a href="#top" aria-label="Back to top">
          Back to top <span aria-hidden="true">↑</span>
        </a>
      </footer>
    </div>
  </body>
</html>
